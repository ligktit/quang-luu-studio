# ── Sao chép thành .env trên VPS rồi điền giá trị thật. KHÔNG commit .env ──

DEBUG=false
BASE_URL=https://license.quangluustudio.com

# Database (khớp docker-compose)
DATABASE_URL=postgresql+psycopg2://qls:CHANGE_DB_PASSWORD@db:5432/qls
POSTGRES_USER=qls
POSTGRES_PASSWORD=CHANGE_DB_PASSWORD
POSTGRES_DB=qls

# ── Khoá ký license (BẮT BUỘC) ───────────────────────────────────────────────
# Sinh: docker compose run --rm api python -m app.cli gen-license-keys
# Lệnh trên in sẵn khối modulus để dán vào LICENSE_PUBLIC_KEY_N phía client
# (core/licensing/jwt_verify.py). Client xác minh chữ ký bằng public key đó, nên
# private key này là thứ duy nhất ngăn người dùng tự chế token Premium.
# Cách 1 — trỏ tới file (khuyến nghị, mount vào container):
LICENSE_PRIVATE_KEY_PATH=/data/license_key.pem
# Cách 2 — dán thẳng PEM vào đây (thay xuống dòng bằng \n):
# LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n
#
# ĐỔI KHOÁ = mọi token đã cấp mất hiệu lực; máy đang chạy sẽ tự check-in lấy
# token mới nếu có mạng, còn máy offline phải kích hoạt lại.

# LEGACY — secret HMAC của cơ chế cũ. Chỉ để ĐỌC token của máy chưa cập nhật.
# Xoá dòng này khi toàn bộ máy đã lên bản mới.
LICENSE_SECRET=

# SINH NGẪU NHIÊN: openssl rand -hex 32
SESSION_SECRET=CHANGE_ME_random_64_hex
# Giữ đúng secret cũ để mã đã phát hành vẫn verify được:
CODE_SECRET=936c3f6655acc46ba5c41603446addb7e5b25df85c953d003eba554527e267e4
# Số ngày máy được chạy offline sau lần check-in gần nhất. 30 chứ không phải 7:
# máy hát ở quán hay dùng 4G chập chờn, hết grace là bị đá ra màn hình kích hoạt.
GRACE_DAYS=30
LICENSE_DURATION_DAYS=365
TRIAL_DAYS=3

# Rate limit — tính theo IP thật của khách (Dockerfile đã bật --forwarded-allow-ips).
RATE_LIMIT_ACTIVATE=30/minute
RATE_LIMIT_VERIFY=120/minute

# Admin — sinh hash: docker compose run --rm api python -m app.cli hash-password 'matkhau'
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Storage
STORAGE_DIR=/data/releases
MAX_UPLOAD_MB=500
